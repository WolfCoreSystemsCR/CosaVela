# Copie este archivo como .env.local y llene los valores. Nunca suba .env.local a Git.
# En Vercel: Project → Settings → Environment Variables.

# Dominio público del sitio (SEO y sitemap)
NEXT_PUBLIC_SITIO_URL=https://cosavela.vercel.app

# WhatsApp del negocio, solo dígitos con código de país (Costa Rica = 506). Ej: 50688887777
NEXT_PUBLIC_WHATSAPP=

# Opcional: cotizaciones de empresas por correo (https://resend.com).
# Si no se configuran, el formulario envía la cotización por WhatsApp.
RESEND_API_KEY=
COTIZACION_PARA=
COTIZACION_DESDE="CosaVela Web <onboarding@resend.dev>"
